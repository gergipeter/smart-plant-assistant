# Plant Identification API (Pl@ntNet)
PLANTNET_API_KEY=your_plantnet_api_key_here

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AI Doctor (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Plant Database (Trefle)
TREFLE_API_KEY=your_trefle_api_key_here

# Image Recognition (Google Vision)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Location & Nurseries (Google Places)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase — Auth, Postgres DB, Storage. Both values are safe to expose
# client-side (Supabase's security model is Row Level Security policies on
# each table, not hiding these). Get these from Supabase Dashboard >
# Settings > API. Run supabase/schema.sql in the SQL Editor once to create
# the required tables (profiles, garden_plants, subscriptions).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase — service_role key (server-side ONLY, never expose to the
# browser). Bypasses Row Level Security — used by the Stripe webhook to
# upgrade a user's subscription without a logged-in session, since Stripe's
# servers call the webhook directly. Get from Settings > API > service_role
# (labeled "secret", distinct from the anon/public key above).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — payments. Get test-mode keys from Dashboard > Developers > API
# keys. Create one recurring Price per tier/cycle in Dashboard > Product
# catalog and set the 4 price IDs below to their price_... values (not the
# product id). STRIPE_WEBHOOK_SECRET comes from `stripe listen` output in
# dev, or Dashboard > Developers > Webhooks > (your endpoint) > Signing
# secret in production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_PLUS_MONTHLY=price_your_plus_monthly_price_id
STRIPE_PRICE_PLUS_YEARLY=price_your_plus_yearly_price_id
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_price_id

# Firebase — Admin SDK (server-side only, used for sending push
# notifications). FIREBASE_KEY is the service account JSON, base64-encoded:
#   base64 -i service-account.json  (macOS/Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))  (PowerShell)
# Get the service account from Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_KEY=your_base64_encoded_service_account_json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase — client-side web app config (safe to expose, same as Supabase's
# anon key above). Get from Firebase Console > Project Settings > General >
# Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# VAPID key for web push — Firebase Console > Project Settings > Cloud
# Messaging > Web configuration > Web Push certificates > Generate key pair.
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key

# OneSignal (alternative notification service)
ONESIGNAL_APP_ID=your_onesignal_app_id

# Resend — sends the daily watering-reminder emails (see
# supabase/functions/send-watering-reminders). Edge Functions do NOT read
# this .env file — this is documentation of what's needed, but the actual
# value must be set as a Supabase secret:
#   supabase secrets set RESEND_API_KEY=re_your_key_here
# Sign up at resend.com, generate an API key. The sandbox sender
# (onboarding@resend.dev) only delivers to your own account email until you
# verify a real sending domain in Resend's dashboard — required before real
# users can receive reminder emails.
RESEND_API_KEY=re_your_resend_api_key

# Public base URL used to build the "open the app" link inside reminder
# emails. Also set as a Supabase secret (supabase secrets set APP_URL=...),
# not read from this file by the Edge Function. Defaults to the deployed
# Cloudflare Worker URL if unset.
APP_URL=https://smart-plant-assistant.gergipeter.workers.dev
